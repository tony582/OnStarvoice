PORT=3000
DATABASE_URL=postgres://onstarvoice:onstarvoice@localhost:5432/onstarvoice
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# First-run bootstrap only. Remove after the first platform_admin is created.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars
BOOTSTRAP_ADMIN_NAME=Platform Admin

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_API_ENDPOINT=

# 图片文字提取（也可复用 llm_provider=qianwen/qwen/dashscope 时的 LLM_API_KEY）。
DASHSCOPE_API_KEY=
QWEN_OCR_API_KEY=
QWEN_OCR_MODEL=qwen-vl-ocr
QWEN_OCR_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_OCR_TENANT_CONCURRENCY=2

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

FEISHU_WEBHOOK_URL=
