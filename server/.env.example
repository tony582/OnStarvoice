# -----------------------------------------------------------------------------
# 运行环境
# -----------------------------------------------------------------------------
NODE_ENV=development
# 仓库支持的本地联调基线为 3001，与 Admin、Dashboard 和本地 Extension 一致。
# 若完全不提供 PORT，服务端代码的兜底值仍是 3000；不要在联调时依赖该兜底。
PORT=3001

# 必填（生产环境必须显式配置，不能依赖代码中的本地开发兜底值）。
DATABASE_URL=postgres://onstarvoice:onstarvoice@localhost:5432/onstarvoice
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# 逗号分隔。只填写确实需要访问 API 的管理端或联调来源。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# 管理端跳转链接、通知邮件链接和临时媒体 URL 的公开基址。
ADMIN_PUBLIC_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3001

# 留空时使用项目内 media 目录；生产建议设置为独立持久化目录。
MEDIA_DIR=

# -----------------------------------------------------------------------------
# 首次启动管理员
# -----------------------------------------------------------------------------
# 仅用于数据库中还没有 platform_admin 时创建首个管理员。
# 首次创建成功后应从生产环境移除密码，后续管理员通过后台管理。
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars
BOOTSTRAP_ADMIN_NAME=Platform Admin

# -----------------------------------------------------------------------------
# 主 LLM：内容判断、分类与分析
# -----------------------------------------------------------------------------
# 支持 gemini、openai、deepseek、qianwen（含 qwen/dashscope 别名）。
# 租户后台中的 LLM 设置优先于这些进程级默认值。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_API_ENDPOINT=https://api.deepseek.com/v1

# 相关性预筛选。未配置可用 DeepSeek 时会安全放行，不会阻断采集。
PREFILTER_SERVER_MODE=conservative
PREFILTER_MODEL_TIMEOUT_MS=15000
PREFILTER_TENANT_CONCURRENCY=6
PREFILTER_DAILY_ITEM_LIMIT=5000

# -----------------------------------------------------------------------------
# 图片 OCR
# -----------------------------------------------------------------------------
# DASHSCOPE_API_KEY 可供 OCR/ASR 共用；QWEN_OCR_API_KEY 优先用于 OCR。
DASHSCOPE_API_KEY=
QWEN_OCR_API_KEY=
QWEN_OCR_MODEL=qwen3.5-ocr
QWEN_OCR_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_OCR_TENANT_CONCURRENCY=2

# -----------------------------------------------------------------------------
# 音视频转写（DashScope Paraformer）
# -----------------------------------------------------------------------------
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_ASR_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
DASHSCOPE_TASK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/tasks

# 临时公开媒体令牌有效期，默认 15 分钟。
ASR_STAGE_TTL_MS=900000

# -----------------------------------------------------------------------------
# 安全事件邮件通知
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# 进程级兜底收件人；租户设置 capture_attention_email_to 可覆盖。
EMAIL_TO=

# -----------------------------------------------------------------------------
# 危险开关
# -----------------------------------------------------------------------------
# 仅在已完成可恢复备份、确认迁移内容且明确需要执行 reset 迁移时临时设为 1。
# 正常开发和生产发布必须保持 0；发布完成后立即恢复。
ALLOW_RESET_MIGRATIONS=0
