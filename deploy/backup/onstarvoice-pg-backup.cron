# StarVoice 生产库每日备份(安装为 /etc/cron.d/onstarvoice-pg-backup,root:root 644)
# 脚本与恢复方法见仓库 deploy/backup/pg-nightly-backup.sh。02:30 避开 03:17 的任务瘦身与 09:00 的报告。
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 2 * * * root /opt/onstarvoice-private/backups/pg-nightly-backup.sh >> /opt/onstarvoice-private/backups/db/cron.log 2>&1
