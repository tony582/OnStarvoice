# StarVoice 生产环境变量模板
#
# 复制为仓库根目录下的 server/.env.production，填写真实值后由部署脚本上传为
# /opt/onstarvoice/server/.env。该文件包含机密，禁止提交 Git。
# 部署脚本会在上传后强制校验以下权限；手工上传时也必须执行：
#   chown root:root /opt/onstarvoice/server/.env
#   chmod 600 /opt/onstarvoice/server/.env

NODE_ENV=production
PORT=3002

# P2-B 生产拓扑仍使用单进程兼容模式。生产必须显式配置，不能留空；
# api/scheduler/ai-media/maintenance 独立入口要到 P2-C 才会启用。
PROCESS_ROLE=all

# PostgreSQL
# 新环境先按 deploy/DEPLOY.md 创建同名登录角色和数据库；密码必须与这里一致。
# 已有生产环境不要为了匹配模板重置角色、密码或数据库所有者，应以已确认的
# DATABASE_URL 为准，并保持部署、备份和恢复命令使用同一 PostgreSQL 角色。
DATABASE_URL=postgresql://onstarvoice:replace-with-strong-password@127.0.0.1:5432/onstarvoice
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# 公网与跨域
CORS_ORIGINS=https://voice.minilife.online
ADMIN_PUBLIC_URL=https://voice.minilife.online/admin
PUBLIC_BASE_URL=https://voice.minilife.online
MEDIA_DIR=/opt/onstarvoice/media

# 首次启动管理员：只在全新数据库且库中尚无 platform_admin 时填写一次。
# 已有管理员的生产库必须保持三项为空；首次创建成功后立即清空并重新部署。
# 不要保留示例邮箱或示例密码，它们会被应用当作真实凭据。
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# 主 LLM。租户后台配置优先于这些进程级默认值。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_API_ENDPOINT=https://api.deepseek.com/v1

# 相关性预筛选
PREFILTER_SERVER_MODE=conservative
PREFILTER_MODEL_TIMEOUT_MS=15000
PREFILTER_TENANT_CONCURRENCY=6
PREFILTER_DAILY_ITEM_LIMIT=5000

# 图片 OCR
DASHSCOPE_API_KEY=
QWEN_OCR_API_KEY=
QWEN_OCR_MODEL=qwen3.5-ocr
QWEN_OCR_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_OCR_TENANT_CONCURRENCY=2

# 音视频转写
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_ASR_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
DASHSCOPE_TASK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/tasks
ASR_STAGE_TTL_MS=900000

# SMTP 邮件通知。飞书、企业微信、短信和电话当前未实现。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# 生产环境始终保持 0。值 1 不是授权开关，也不能用于执行 reset 迁移；
# reset 只能按受控发布手册另行评审和处置，应用发布入口会拒绝该值。
ALLOW_RESET_MIGRATIONS=0
